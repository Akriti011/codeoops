# CodeOops — vLLM 14B profile (manager's GPU laptop). Copy to .env there.
#
# Every stage (overview + HLD + LLD) runs on the same vLLM-served
# Qwen2.5-Coder-14B-Instruct-AWQ model — CodeWiki is the only document
# generator, vLLM 14B is the only model. No Ollama dependency: this laptop
# does not need Ollama installed or running at all with this profile.
#
# Start the full stack (including the GPU-only vllm service, which
# `docker compose up` skips by default) with:
#
#   docker compose --profile gpu up -d --build
#
# First start downloads the 14B model into the hf-cache volume — allow
# several minutes before the vllm container reports healthy.

DOCUMENTATION_PROVIDER=codewiki
CODEWIKI_BASE_URL=http://codewiki:8000
ALLOWED_ORIGINS=http://localhost:4200
ALLOWED_REPOSITORY_HOSTS=github.com
UPLOAD_MAX_ARCHIVE_BYTES=2147483648
UPLOAD_MAX_EXTRACTED_BYTES=8589934592
UPLOAD_MAX_FILE_COUNT=200000

# --- Inference: vLLM 14B, every stage. No other model is configured ------
INFERENCE_BACKEND=vllm
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=dummy
MAIN_MODEL=qwen2.5-coder-14b
FALLBACK_MODEL_1=qwen2.5-coder-14b
CLUSTER_MODEL=qwen2.5-coder-14b
OVERVIEW_MODEL=qwen2.5-coder-14b
HLD_MODEL=qwen2.5-coder-14b
LLD_MODEL=qwen2.5-coder-14b
# Deliberately no {STAGE}_LLM_BASE_URL / {STAGE}_LLM_API_KEY overrides —
# every stage uses the same single vLLM endpoint above. Deliberately no
# {STAGE}_NUM_CTX / OLLAMA_NUM_CTX — those are Ollama-only knobs, ignored
# for a vLLM endpoint (context is fixed server-side, see VLLM_MAX_MODEL_LEN
# below).

# --- vLLM server itself (docker-compose.yml's `vllm` service) ------------
VLLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
VLLM_SERVED_NAME=qwen2.5-coder-14b
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.92

# --- Pipeline stages -------------------------------------------------------
OVERVIEW_ONLY_MODE=true
HLD_ENABLED=true
LLD_ENABLED=true
DOC_VALIDATOR_ENABLED=true

# --- Output length / evidence coverage, scaled up for a 14B/32k-context, ---
# --- GPU-backed model instead of the 7B/12k-context CPU defaults ----------
OVERVIEW_MAX_OUTPUT_TOKENS=6000
HLD_MAX_TOKENS=7000
LLD_MAX_TOKENS=8000
EVIDENCE_TOKEN_BUDGET=20000
EVIDENCE_MAX_REPRESENTATIVE_FILES=40
EVIDENCE_MAX_SIGNAL_FINDINGS=80
LLD_CODE_CONTEXT_FILES=30

LLM_REQUEST_TIMEOUT_SECONDS=1200
