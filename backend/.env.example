# Copy to .env and adjust. Nothing here is required to run locally —
# every value below is also the built-in default.

# --- Application ---
APP_NAME=CodeOops API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# --- HTTP ---
HOST=127.0.0.1
PORT=8000

# Comma-separated. Must include the Angular dev server origin.
ALLOWED_ORIGINS=http://localhost:4200

# --- Repository policy ---
# Comma-separated list of Git hosts that may be submitted.
ALLOWED_REPOSITORY_HOSTS=github.com
DEFAULT_BRANCH_FALLBACK=main

# --- Documentation provider ---
# Empty by default: no documentation engine connected. Set to `codewiki` to
# wire the real adapter — the three CodeWiki settings below become required.
DOCUMENTATION_PROVIDER=

# --- CodeWiki ---
# Base URL of a running CodeWiki web app instance.
CODEWIKI_BASE_URL=http://localhost:8000
# The host directory CodeWiki mounts at /app/output — the shared volume its
# docs_path values are read relative to. Must match CodeWiki's own mount.
CODEWIKI_OUTPUT_ROOT=/absolute/path/to/CodeWiki/output
# Where CodeOops copies verified CodeWiki bytes on job completion.
ARTIFACT_ROOT=./var/artifacts
CODEWIKI_TIMEOUT_SECONDS=7200
CODEWIKI_POLL_INTERVAL_SECONDS=5
