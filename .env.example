# CodeOops Docker Compose configuration.
#
# Copy to .env and adjust if needed — every value below is also the current
# tuned default. OLLAMA_NUM_CTX/EVIDENCE_TOKEN_BUDGET/OVERVIEW_MAX_OUTPUT_TOKENS
# were measured against an 8GB Apple Silicon Mac — see "Docker resource
# notes" in README.md before raising them on a similarly-constrained host.
#
# Every name here is the real variable the code already reads (backend's
# app/core/config.py Settings, or CodeWiki's config.py/llm_services.py) —
# nothing invented, nothing renamed.

# --- Backend (app/core/config.py) --------------------------------------
DOCUMENTATION_PROVIDER=codewiki
CODEWIKI_BASE_URL=http://codewiki:8000
ALLOWED_ORIGINS=http://localhost:4200
ALLOWED_REPOSITORY_HOSTS=github.com
# CODEWIKI_OUTPUT_ROOT and ARTIFACT_ROOT are fixed to the shared Docker
# volume mount points in docker-compose.yml (/data/codewiki-output,
# /data/artifacts) and are not meant to be overridden here.

# --- CodeWiki / Ollama (codewiki/codewiki/config.py, llm_services.py) --
# Ollama itself is NOT a container in this stack — it must be running
# natively on the host (Ollama.app or `ollama serve`) with this model
# already pulled. host.docker.internal is how the codewiki container
# reaches it; do not point this at a machine-specific IP.
#
# MAIN_MODEL is the fallback model for every stage that has no per-stage
# override below. On a 7B dev laptop, set all three to your 7B model.
MAIN_MODEL=qwen2.5-coder:7b
FALLBACK_MODEL_1=qwen2.5-coder:7b
CLUSTER_MODEL=qwen2.5-coder:7b
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=dummy

# Inference engine routing hint. "ollama" (default) uses Ollama's native
# /api/chat path for per-call num_ctx + serializes calls. "vllm" / "openai"
# means "plain OpenAI-compatible" (vLLM, TGI, an API): context is fixed at
# the server, num_ctx is not sent. The actual endpoint is still LLM_BASE_URL
# (or a per-stage {STAGE}_LLM_BASE_URL).
INFERENCE_BACKEND=ollama

# ======================================================================
# MODEL-AGNOSTIC PIPELINE  —  Project -> Overview -> HLD -> LLD
# ----------------------------------------------------------------------
# Every stage resolves its own model + decoding params. Anything left
# blank inherits from the overview stage, which inherits from MAIN_MODEL /
# OLLAMA_NUM_CTX / OVERVIEW_MAX_OUTPUT_TOKENS. Leaving this whole block
# blank == the pre-pipeline 7B behaviour, unchanged.
#
# Switching machines is env-only, no code change. Run
#   python3 scripts/model_advisor.py
# on the target machine for a hardware-based recommendation.
#
# ---- PROFILE: 7B laptop (this machine's default) ----------------------
#   leave OVERVIEW_MODEL / HLD_MODEL / LLD_MODEL blank; MAIN_MODEL is used.
OVERVIEW_MODEL=
OVERVIEW_NUM_CTX=
OVERVIEW_MAX_TOKENS=
OVERVIEW_TEMPERATURE=
#
# ---- PROFILE: GPU laptop — 14B via the bundled vLLM service --------
#   Bring the stack up with:  docker compose --profile gpu up -d --build
#   Overview stays on host Ollama 7B; HLD + LLD go to the vLLM container.
#
#   INFERENCE_BACKEND=vllm
#   HLD_LLM_BASE_URL=http://vllm:8000/v1
#   HLD_MODEL=qwen2.5-coder-14b            # == VLLM_SERVED_NAME
#   HLD_NUM_CTX=24576
#   HLD_MAX_TOKENS=6000
#   LLD_LLM_BASE_URL=http://vllm:8000/v1
#   LLD_MODEL=qwen2.5-coder-14b
#   LLD_NUM_CTX=32000
#   LLD_MAX_TOKENS=8000
#   # vLLM server knobs (see docker-compose.yml `vllm` service):
#   VLLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
#   VLLM_SERVED_NAME=qwen2.5-coder-14b
#   VLLM_MAX_MODEL_LEN=32768               # must be >= the largest *_NUM_CTX above
#   VLLM_GPU_MEMORY_UTILIZATION=0.92
#   HUGGING_FACE_HUB_TOKEN=                # only if the model repo is gated
#
# ---- PROFILE: everything on 14B vLLM (24GB+ GPU) ------------------
#   INFERENCE_BACKEND=vllm
#   LLM_BASE_URL=http://vllm:8000/v1
#   MAIN_MODEL=qwen2.5-coder-14b
#   OVERVIEW_MODEL=qwen2.5-coder-14b
#   HLD_MODEL=qwen2.5-coder-14b
#   LLD_MODEL=qwen2.5-coder-14b
#   VLLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
#   VLLM_MAX_MODEL_LEN=32768
#
# ---- PROFILE: 32B vLLM (40GB+ GPU) ------------------------------
#   as above, with
#   VLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ
#   VLLM_MAX_MODEL_LEN=32768
#   VLLM_GPU_MEMORY_UTILIZATION=0.95
#
# ---- PROFILE: frontier API for HLD/LLD, local 7B overview ----------
#   HLD_LLM_BASE_URL=https://api.openai.com/v1
#   HLD_LLM_API_KEY=sk-...
#   HLD_MODEL=gpt-4o
#   LLD_LLM_BASE_URL=https://api.openai.com/v1
#   LLD_LLM_API_KEY=sk-...
#   LLD_MODEL=gpt-4o
#
HLD_ENABLED=true
HLD_MODEL=
HLD_NUM_CTX=
HLD_MAX_TOKENS=
HLD_TEMPERATURE=
HLD_LLM_BASE_URL=
HLD_LLM_API_KEY=
LLD_ENABLED=true
LLD_MODEL=
LLD_NUM_CTX=
LLD_MAX_TOKENS=
LLD_TEMPERATURE=
LLD_LLM_BASE_URL=
LLD_LLM_API_KEY=
# How many central components' source files the LLD stage may pull in.
LLD_CODE_CONTEXT_FILES=12
# Deterministic grounding check of every generated doc against the
# structured overview IR. Keep this on.
DOC_VALIDATOR_ENABLED=true
# ======================================================================

# Optional: GitHub Personal Access Token so the engine can clone PRIVATE
# repositories by URL. Leave blank for public repos only (the ZIP upload
# path never needs this). Use a read-only token — a fine-grained PAT with
# just "Contents: Read-only" on the repos you need, or a classic PAT with
# the "repo" scope. docker-entrypoint.sh injects it into git inside the
# container; it is never written into the image. .env is gitignored — keep
# it that way.
GITHUB_TOKEN=

# Single-overview generation mode: exactly one overview.md per repository,
# no module docs, no agentic sub-module generation. Do not disable.
OVERVIEW_ONLY_MODE=true

# Resource bounds tuned for an 8GB Apple Silicon host. Raising OLLAMA_NUM_CTX
# without more headroom risks Metal→CPU fallback and system-wide swap
# thrashing (see README.md) — the single biggest throughput cliff found
# during tuning.
OLLAMA_NUM_CTX=4096
OVERVIEW_MAX_OUTPUT_TOKENS=1500
EVIDENCE_TOKEN_BUDGET=1100
EVIDENCE_MAX_REPRESENTATIVE_FILES=3

# Hard per-request LLM timeout. Paired with max_retries=0 (not configurable
# via env — baked into codewiki/codewiki/src/be/llm_services.py
# create_openai_client on purpose: retrying an already-timed-out local
# generation only multiplies the wait, it never rescues it).
LLM_REQUEST_TIMEOUT_SECONDS=1200
