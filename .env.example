# CodeOops Docker Compose configuration.
#
# Copy to .env and adjust if needed — every value below is also the current
# tuned default. OLLAMA_NUM_CTX/EVIDENCE_TOKEN_BUDGET/OVERVIEW_MAX_OUTPUT_TOKENS
# were measured against an 8GB Apple Silicon Mac — see "Docker resource
# notes" in README.md before raising them on a similarly-constrained host.
#
# Every name here is the real variable the code already reads (backend's
# app/core/config.py Settings, or CodeWiki's config.py/llm_services.py) —
# nothing invented, nothing renamed.

# --- Backend (app/core/config.py) --------------------------------------
DOCUMENTATION_PROVIDER=codewiki
CODEWIKI_BASE_URL=http://codewiki:8000
ALLOWED_ORIGINS=http://localhost:4200
ALLOWED_REPOSITORY_HOSTS=github.com
# CODEWIKI_OUTPUT_ROOT and ARTIFACT_ROOT are fixed to the shared Docker
# volume mount points in docker-compose.yml (/data/codewiki-output,
# /data/artifacts) and are not meant to be overridden here.

# --- CodeWiki / Ollama (codewiki/codewiki/config.py, llm_services.py) --
# Ollama itself is NOT a container in this stack — it must be running
# natively on the host (Ollama.app or `ollama serve`) with this model
# already pulled. host.docker.internal is how the codewiki container
# reaches it; do not point this at a machine-specific IP.
MAIN_MODEL=codewiki-qwen2.5-16k:latest
FALLBACK_MODEL_1=codewiki-qwen2.5-16k:latest
CLUSTER_MODEL=codewiki-qwen2.5-16k:latest
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=dummy

# Optional: GitHub Personal Access Token so the engine can clone PRIVATE
# repositories by URL. Leave blank for public repos only (the ZIP upload
# path never needs this). Use a read-only token — a fine-grained PAT with
# just "Contents: Read-only" on the repos you need, or a classic PAT with
# the "repo" scope. docker-entrypoint.sh injects it into git inside the
# container; it is never written into the image. .env is gitignored — keep
# it that way.
GITHUB_TOKEN=

# Single-overview generation mode: exactly one overview.md per repository,
# no module docs, no agentic sub-module generation. Do not disable.
OVERVIEW_ONLY_MODE=true

# Resource bounds tuned for an 8GB Apple Silicon host. Raising OLLAMA_NUM_CTX
# without more headroom risks Metal→CPU fallback and system-wide swap
# thrashing (see README.md) — the single biggest throughput cliff found
# during tuning.
OLLAMA_NUM_CTX=4096
OVERVIEW_MAX_OUTPUT_TOKENS=1500
EVIDENCE_TOKEN_BUDGET=1100
EVIDENCE_MAX_REPRESENTATIVE_FILES=3

# Hard per-request LLM timeout. Paired with max_retries=0 (not configurable
# via env — baked into codewiki/codewiki/src/be/llm_services.py
# create_openai_client on purpose: retrying an already-timed-out local
# generation only multiplies the wait, it never rescues it).
LLM_REQUEST_TIMEOUT_SECONDS=1200
